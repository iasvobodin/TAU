    "bwip-js": "^4.5.1",
    "docx": "^9.2.0",
    "file-saver": "^2.0.5",
    "pinia": "^3.0.1",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.16.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.14"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
