    "bwip-js": "^4.6.0",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "libreoffice-convert": "^1.6.1",
    "pinia": "^3.0.3",
    "socket.io-client": "^4.8.1",
    "ssh2": "^1.16.0",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vuetify": "^3.8.11"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
