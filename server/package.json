{
  "name": "bun-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "prisma": "^6.6.0",
    "prisma-zod-generator": "^0.8.13"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun --hot run ./index.ts",
    "build": "cross-env NODE_ENV=production bun build --entrypoints ./index.ts --outdir ../shared --target node",
    "compile": "cross-env NODE_ENV=production bun build --compile --minify --sourcemap ./index.ts --outfile server",
    "studio": "bunx prisma studio"
  },
  "peerDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/client": "^6.6.0",
    "dotenv": "^16.5.0",
    "fastify": "^4.29.0",
    "fastify-plugin": "^4.5.1",
    "pino": "^9.7.0",
    "pino-multi-stream": "^6.0.0",
    "zod": "^3.25.51"
  }
}