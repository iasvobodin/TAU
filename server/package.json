{
  "name": "bun-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/mssql": "^9.1.9",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.2",
    "prisma-zod-generator": "^1.32.2"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun --hot run ./index.ts",
    "devServer": "cross-env NODE_ENV=development bun --hot run ./server.ts",
    "build": "cross-env NODE_ENV=production bun build --entrypoints ./server.ts --outdir ../shared --target node",
    "compile": "cross-env NODE_ENV=production bun build --compile --minify --sourcemap ./index.ts --outfile server",
    "studio": "bunx prisma studio"
  },
  "peerDependencies": {
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-mssql": "^7.4.2",
    "@prisma/client": "^6.19.2",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "fastify": "^5.7.4",
    "fastify-multipart": "^5.4.0",
    "fastify-plugin": "^5.1.0",
    "mssql": "^12.2.0",
    "pino": "^9.14.0",
    "pino-multi-stream": "^6.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.3.6"
  }
}
