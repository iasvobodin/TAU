{
  "name": "bun-server",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pino-multi-stream": "^5.1.6",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.0.0",
    "pino-pretty": "^13.1.1",
    "prisma": "^6.15.0",
    "prisma-zod-generator": "^1.18.5"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development bun --hot run ./index.ts",
    "build": "cross-env NODE_ENV=production bun build --entrypoints ./index.ts --outdir ../shared --target node",
    "compile": "cross-env NODE_ENV=production bun build --compile --minify --sourcemap ./index.ts --outfile server",
    "studio": "bunx prisma studio"
  },
  "peerDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.5.0",
    "fastify-multipart": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "pino": "^9.9.1",
    "pino-multi-stream": "^6.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.1.5"
  }
}
