generator client {
  provider = "prisma-client-js"
  output   = "../../extensions/src"
}

datasource db {
  provider          = "sqlserver"
  url               = "sqlserver://10.69.19.59:1433;database=TAU;user=TAUadmin;password=Tau74;encrypt=true;trustServerCertificate=true"
  shadowDatabaseUrl = "sqlserver://10.69.19.59:1433;database=shadowTAU;user=TAUadmin;password=Tau74;encrypt=true;trustServerCertificate=true"
}

model User {
  id    Int    @id @default(autoincrement())
  Login String @unique
  Name  String
}

model Component {
  id                  Int                   @id @default(autoincrement())
  snComponent         String                @unique
  pnComponentId       String
  supplier            String
  invoice             String
  status              String
  comment             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                String
  snProductId         String?
  pnComponent         PartNumberComponent   @relation(fields: [pnComponentId], references: [partNumber])
  snProduct           Product?              @relation(fields: [snProductId], references: [snProduct])
  ProductionOperation ProductionOperation[]
}

model PartNumberComponent {
  id            Int         @id @default(autoincrement())
  partNumber    String      @unique
  descriptionRU String
  descriptionEN String
  Component     Component[]
}

model ProductionOperation {
  id             Int        @id @default(autoincrement())
  stageType      String
  date           DateTime   @default(now())
  status         String
  user           String
  productSN      String?
  comment        String?    @db.Text
  productId      String?
  componentId    String?
  usedComponents String?
  component      Component? @relation(fields: [componentId], references: [snComponent], onDelete: NoAction, onUpdate: NoAction)
  product        Product?   @relation(fields: [productId], references: [snProduct])
}

model Product {
  id                     Int                   @id @default(autoincrement())
  snProduct              String                @unique
  specificationProductMP String
  comment                String?
  orderToProduction      String?
  components             Component[]
  specification          Specification         @relation(fields: [specificationProductMP], references: [productMP])
  productionOperations   ProductionOperation[]
}

model Specification {
  id               Int        @id @default(autoincrement())
  version          Int
  type             String?
  productName      String
  productMP        String     @unique
  productMM        String
  electronicBoard1 String
  electronicBoard2 String
  electronicBoard3 String
  electronicBoard4 String
  electronicBoard5 String
  electronicBoard6 String
  otherCirciutry   String
  enclosureType    String
  mountingScrew    String
  packingBox       String
  operationId      Int        @default(1)
  templateId       Int        @default(1)
  testId           Int        @default(1)
  product          Product[]
  operation        Operation  @relation(fields: [operationId], references: [id])
  template         Template   @relation(fields: [templateId], references: [id])
  test             Test       @relation(fields: [testId], references: [id])
  checkList        CheckList? // связь один-к-одному (может быть optional)
}

model Operation {
  id             Int             @id @default(autoincrement())
  version        Int
  issue          Boolean
  preProdaction  Boolean
  assembly       Boolean
  marking        Boolean
  functionalTest Boolean
  verification   Boolean
  package        Boolean
  specification  Specification[]
}

model Template {
  id                   Int             @id @default(autoincrement())
  version              Int
  markingTemplate      String
  markingEquipment     String
  stendForHiPot        String
  stendForTest         String
  verificationProtocol String
  RE                   String
  PS                   String
  boxLabel             String
  specification        Specification[]
}

model Test {
  id            Int             @id @default(autoincrement())
  version       Int
  partNumber    String?
  checklist     String?
  HiPot         String
  specification Specification[]
}

model CheckList {
  id                Int           @id @default(autoincrement())
  checkListTemplate String        @db.Text
  doc_AssebbleOK    String?
  doc_TestOK        String?
  doc_ConstructKD   String?
  doc_Passport      String?
  doc_TemplateEZCAD String?
  productMP         String        @unique
  specification     Specification @relation(fields: [productMP], references: [productMP])
}
