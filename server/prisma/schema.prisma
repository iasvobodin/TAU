generator client {
  provider = "prisma-client-js"
  output   = "../../extensions/src"
}

datasource db {
  provider          = "sqlserver"
  url               = "sqlserver://10.69.19.59:1433;database=TAU;user=TAUadmin;password=Tau74;encrypt=true;trustServerCertificate=true"
  shadowDatabaseUrl = "sqlserver://10.69.19.59:1433;database=shadowTAU;user=TAUadmin;password=Tau74;encrypt=true;trustServerCertificate=true"
}

model User {
  id    Int    @id @default(autoincrement())
  Login String @unique @db.VarChar(255)
  Name  String @db.VarChar(255)
}

model Component {
  id                  Int                   @id @default(autoincrement())
  snComponent         String                @unique @db.VarChar(255)
  pnComponentId       String                @db.VarChar(255)
  supplier            String                @db.VarChar(255)
  invoice             String                @db.VarChar(255)
  status              String                @db.VarChar(255)
  comment             String                @db.VarChar(255)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  user                String                @db.VarChar(255)
  snProductId         String?               @db.VarChar(255)
  pnComponent         PartNumberComponent   @relation(fields: [pnComponentId], references: [partNumber])
  snProduct           Product?              @relation(fields: [snProductId], references: [snProduct])
  ProductionOperation ProductionOperation[]
}

model PartNumberComponent {
  id            Int         @id @default(autoincrement())
  partNumber    String      @unique @db.VarChar(255)
  descriptionRU String      @db.VarChar(255)
  descriptionEN String      @db.VarChar(255)
  Component     Component[]
}

model ProductionOperation {
  id             Int        @id @default(autoincrement())
  stageType      String     @db.VarChar(255)
  date           DateTime   @default(now())
  status         String     @db.VarChar(255)
  user           String     @db.VarChar(255)
  productSN      String?    @db.VarChar(255)
  comment        String?    @db.VarChar(255)
  productId      String?    @db.VarChar(255)
  componentId    String?    @db.VarChar(255)
  usedComponents String?    @db.VarChar(255)
  component      Component? @relation(fields: [componentId], references: [snComponent], onDelete: NoAction, onUpdate: NoAction)
  product        Product?   @relation(fields: [productId], references: [snProduct])
}

model Product {
  id                     Int                   @id @default(autoincrement())
  snProduct              String                @unique @db.VarChar(255)
  specificationProductMP String                @db.VarChar(255)
  comment                String?               @db.VarChar(255)
  orderToProduction      String?               @db.VarChar(255)
  components             Component[]
  specification          Specification         @relation(fields: [specificationProductMP], references: [productMP])
  productionOperations   ProductionOperation[]
}

model Specification {
  id               Int       @id @default(autoincrement())
  version          Int
  type             String?   @db.VarChar(255)
  productName      String    @db.VarChar(255)
  productMP        String    @unique @db.VarChar(255)
  productMM        String    @db.VarChar(255)
  electronicBoard1 String    @db.VarChar(255)
  electronicBoard2 String    @db.VarChar(255)
  electronicBoard3 String    @db.VarChar(255)
  electronicBoard4 String    @db.VarChar(255)
  electronicBoard5 String    @db.VarChar(255)
  electronicBoard6 String    @db.VarChar(255)
  otherCirciutry   String    @db.VarChar(255)
  enclosureType    String    @db.VarChar(255)
  mountingScrew    String    @db.VarChar(255)
  packingBox       String    @db.VarChar(255)
  operationId      Int       @default(1)
  templateId       Int       @default(1)
  testId           Int       @default(1)
  product          Product[]
  operation        Operation @relation(fields: [operationId], references: [id])
  template         Template  @relation(fields: [templateId], references: [id])
  test             Test      @relation(fields: [testId], references: [id])
}

model Operation {
  id             Int             @id @default(autoincrement())
  version        Int
  issue          Boolean
  preProdaction  Boolean
  assembly       Boolean
  marking        Boolean
  functionalTest Boolean
  verification   Boolean
  package        Boolean
  specification  Specification[]
}

model Template {
  id                   Int             @id @default(autoincrement())
  version              Int
  markingTemplate      String          @db.VarChar(255)
  markingEquipment     String          @db.VarChar(255)
  stendForHiPot        String          @db.VarChar(255)
  stendForTest         String          @db.VarChar(255)
  verificationProtocol String          @db.VarChar(255)
  RE                   String          @db.VarChar(255)
  PS                   String          @db.VarChar(255)
  boxLabel             String          @db.VarChar(255)
  specification        Specification[]
}

model Test {
  id            Int             @id @default(autoincrement())
  version       Int
  partNumber    String?         @db.VarChar(255)
  checklist     String?         @db.VarChar(255)
  HiPot         String          @db.VarChar(255)
  specification Specification[]
}
